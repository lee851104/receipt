# Copy to .env (never committed) and set JWT_SECRET, at least 32 characters:
#   .venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# 1 opens the demo quick switch (demo users log in without a password); keep 0 anywhere other people can reach.
DEMO_MODE=1
DATABASE_URL=sqlite:///data/app.db
LLAMA_SERVER_URL=http://127.0.0.1:8080
# fake | bert. Install requirements-docker.txt for CPU BERT and a verified local bundle; load failure reports unavailable.
CATEGORY_MODEL=fake
# fake | qwen. qwen needs role 3's src/ml/attributes.py (merge its branch first); without it the server stops with one line.
ATTRIBUTES_MODEL=fake
# 0 to 1: a name whose best category is less likely than this counts as 待確認
CATEGORY_MIN_PROB=0.5
# Local verified bundle. Direct uvicorn/start.bat do not download.
CATEGORY_MODEL_DIR=models/category
# Optional container download. For the Protected demo, TYPE=space requires full commit + SHA256.
# No credentials in this file; use local hf auth login or HF_TOKEN_FILE outside Git.
CATEGORY_MODEL_REPO=
CATEGORY_MODEL_REVISION=
CATEGORY_MODEL_REPO_TYPE=model
CATEGORY_MODEL_SHA256=
