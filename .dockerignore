# Nothing private may reach the image (design D14); the Dockerfile copies only configs/ and src/ anyway.
.git/
.venv/
rawdata/
data/
models/
runtime/
experiments/
prototypes/
**/*.csv
**/*.tsv
**/*.xls
**/*.xlsx
**/*.rar
**/*.zip
**/*.7z
.env
.env.*
# v1's build input is never served, and a developer's copy may hold generated report data
src/web/
**/*-data.js
**/__pycache__/
