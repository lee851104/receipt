# Copy to .env (never committed) and set JWT_SECRET, at least 32 characters:
#   .venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# 1 opens the demo quick switch (demo users log in without a password); keep 0 anywhere other people can reach.
DEMO_MODE=1
DATABASE_URL=sqlite:///data/app.db
LLAMA_SERVER_URL=http://127.0.0.1:8080
# fake | bert. bert reports unavailable on the health check until the real model is wired in (task 2.15), even when a
# model is in CATEGORY_MODEL_DIR.
CATEGORY_MODEL=fake
# fake | qwen (only fake works until src/ml has the real model)
ATTRIBUTES_MODEL=fake
# 0 to 1: a name whose best category is less likely than this counts as 待確認
CATEGORY_MIN_PROB=0.5
# Where CATEGORY_MODEL=bert reads its model (relative to the repository). REPO and REVISION (both or neither) name the
# public Hugging Face repo and the fixed commit that only the Docker container downloads a missing model from:
# start.bat and uvicorn never download (huggingface_hub is only in requirements-docker.txt).
CATEGORY_MODEL_DIR=models/category
CATEGORY_MODEL_REPO=
CATEGORY_MODEL_REVISION=
